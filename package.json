{
  "name": "resume",
  "version": "2.1.0",
  "description": "Resume of Ludovic Valente",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "split": "node scripts/split-i18n.js",
    "build": "node scripts/build.js",
    "build:site": "node scripts/build.js --target html --target pdf",
    "build:europass": "node scripts/build.js --target europass-xml --target europass-html --target europass-pdf",
    "build:public": "npm run build:site && npm run build:europass && npm run validate",
    "build:all": "npm run split && npm run build:public",
    "build:pdf": "node scripts/build.js --with-pdf",
    "build:europass-xml": "node scripts/build.js --target europass-xml && node scripts/validate-europass-xml.js",
    "validate": "node scripts/validate-europass-xml.js",
    "xsd": "node scripts/download-europass-xsd.js"
  },
  "homepage": "https://github.com/ludoo0d0a/resume#readme",
  "bugs": {
    "url": "https://github.com/ludoo0d0a/resume/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludoo0d0a/resume.git"
  },
  "license": "ISC",
  "author": "Ludovic Valente",
  "dependencies": {
    "emoji-flags": "^1.3.0",
    "gravatar": "^1.8.2",
    "handlebars": "4.7.9",
    "jsonresume-theme-ludoo": "^0.0.4"
  },
  "keywords": [
    "cv",
    "resume",
    "json",
    "jsonresume",
    "json-resume",
    "theme",
    "europass"
  ]
}
